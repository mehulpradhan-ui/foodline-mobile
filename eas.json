{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_APP_ENV": "development", "EXPO_PUBLIC_DEMO_MODE": "1" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "staging" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "demo": {
      "distribution": "internal",
      "channel": "demo",
      "env": { "EXPO_PUBLIC_APP_ENV": "staging", "EXPO_PUBLIC_DEMO_MODE": "1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "production" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "ios": { "appleTeamId": "REPLACE_WITH_PROQUBE_TEAM_ID" },
      "android": { "track": "internal" }
    }
  }
}
