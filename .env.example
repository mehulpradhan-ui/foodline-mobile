# Copy to .env.local (git-ignored) and fill in. Restart with `npx expo start --clear`.

# 1 = run entirely on bundled fixtures. No backend needed. Works offline.
EXPO_PUBLIC_DEMO_MODE=1

# From Supabase dashboard → Project Settings → API.
# The anon key is public by design; RLS is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
EXPO_PUBLIC_SUPABASE_PROJECT_ID=YOUR-PROJECT-ID

# Optional: set once an ERP REST/Edge gateway exists in front of Supabase.
# EXPO_PUBLIC_API_BASE_URL=https://api.foodlineai.com

EXPO_PUBLIC_APP_ENV=development
